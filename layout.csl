// =============================================================================
// layout.csl — chain-reduction Top-K k-NN on a LAYOUT_P × LAYOUT_P grid
// =============================================================================
//
// Topology:
//   EW chain (all rows parallel): PE(LAYOUT_P-1, y) → ... → PE(0, y)
//   NS chain (col 0 only):        PE(0, LAYOUT_P-1) → ... → PE(0, 0)  ← result
//   Each hop: receiver merges its K with sender's K, keeps K-best, forwards.
//
// Colors (4 total, ping-pong per direction): even-stride PEs receive on
// color_a, send on color_b; odd-stride PEs are the inverse. Endpoints only
// configure the color they actually use. NS only on col 0.
//
// LAYOUT_P chosen at compile time (see below). For most cases it expands
// beyond the host-passed P to use idle PEs; for k_large it stays = P to
// preserve the SORT_ALL fast path on K==rows_per_pe.
// =============================================================================

param P : u16;
param d_dim : u16;
param rows_per_pe : u16;
param K : u16;

// Multi-PE redistribution. Fires only when K < rows_per_pe — preserves the
// SORT_ALL fast path on cases like k_large where K == rows_per_pe (multi-PE
// would force non-SORT_ALL and add chain hop overhead exceeding sort savings).
// FABRIC_MAX_P should match the largest square grid the fabric supports;
// raise it via --params=FABRIC_MAX_P:N for larger fabrics.
const FABRIC_MAX_P : u16 = 4;
const USE_MULTI_PE : bool = K < rows_per_pe;
const LAYOUT_P : u16 = if (USE_MULTI_PE) FABRIC_MAX_P else P;
const effective_rows_per_pe : u16 = rows_per_pe * P * P / (LAYOUT_P * LAYOUT_P);

// 4 colors for chain reduction.
const ew_color_a : color = @get_color(0);
const ew_color_b : color = @get_color(1);
const ns_color_a : color = @get_color(4);
const ns_color_b : color = @get_color(5);

const memcpy = @import_module("<memcpy/get_params>", .{
  .width = LAYOUT_P,
  .height = LAYOUT_P,
});

layout {
  @set_rectangle(LAYOUT_P, LAYOUT_P);

  var Px : u16 = 0;
  while (Px < LAYOUT_P) : (Px += 1) {
    const memcpy_params = memcpy.get_params(Px);
    var Py : u16 = 0;
    while (Py < LAYOUT_P) : (Py += 1) {
      const ew_send_color = if (Px % 2 == 1) ew_color_a else ew_color_b;
      const ew_recv_color = if ((Px + 1) % 2 == 1) ew_color_a else ew_color_b;
      const ns_send_color = if (Py % 2 == 1) ns_color_a else ns_color_b;
      const ns_recv_color = if ((Py + 1) % 2 == 1) ns_color_a else ns_color_b;

      // Role flags use LAYOUT_P (effective grid size)
      const is_ew_sender : bool = Px > 0;
      const is_ew_recver : bool = Px < LAYOUT_P - 1;
      const is_ns_sender : bool = (Px == 0) and (Py > 0);
      const is_ns_recver : bool = (Px == 0) and (Py < LAYOUT_P - 1);

      @set_tile_code(Px, Py, "pe.csl", .{
        .memcpy_params = memcpy_params,
        .P = LAYOUT_P,
        .d_dim = d_dim,
        .rows_per_pe = effective_rows_per_pe,
        .K = K,
        .ew_send_color = ew_send_color,
        .ew_recv_color = ew_recv_color,
        .ns_send_color = ns_send_color,
        .ns_recv_color = ns_recv_color,
        .is_ew_sender = is_ew_sender,
        .is_ew_recver = is_ew_recver,
        .is_ns_sender = is_ns_sender,
        .is_ns_recver = is_ns_recver,
      });
    }
  }

  // ---------------------------------------------------------------------------
  // ROUTING TABLES
  // ---------------------------------------------------------------------------
  const RX_RAMP_TX_WEST  = .{ .rx = .{RAMP},  .tx = .{WEST}  };
  const RX_EAST_TX_RAMP  = .{ .rx = .{EAST},  .tx = .{RAMP}  };
  const RX_RAMP_TX_NORTH = .{ .rx = .{RAMP},  .tx = .{NORTH} };
  const RX_SOUTH_TX_RAMP = .{ .rx = .{SOUTH}, .tx = .{RAMP}  };

  Px = 0;
  while (Px < LAYOUT_P) : (Px += 1) {
    var Py : u16 = 0;
    while (Py < LAYOUT_P) : (Py += 1) {
      if (Px > 0 and Px % 2 == 1) {
        @set_color_config(Px, Py, ew_color_a, .{ .routes = RX_RAMP_TX_WEST });
      } else if (Px < LAYOUT_P - 1 and Px % 2 == 0) {
        @set_color_config(Px, Py, ew_color_a, .{ .routes = RX_EAST_TX_RAMP });
      }
      if (Px > 0 and Px % 2 == 0) {
        @set_color_config(Px, Py, ew_color_b, .{ .routes = RX_RAMP_TX_WEST });
      } else if (Px < LAYOUT_P - 1 and Px % 2 == 1) {
        @set_color_config(Px, Py, ew_color_b, .{ .routes = RX_EAST_TX_RAMP });
      }
      if (Px == 0) {
        if (Py > 0 and Py % 2 == 1) {
          @set_color_config(Px, Py, ns_color_a, .{ .routes = RX_RAMP_TX_NORTH });
        } else if (Py < LAYOUT_P - 1 and Py % 2 == 0) {
          @set_color_config(Px, Py, ns_color_a, .{ .routes = RX_SOUTH_TX_RAMP });
        }
        if (Py > 0 and Py % 2 == 0) {
          @set_color_config(Px, Py, ns_color_b, .{ .routes = RX_RAMP_TX_NORTH });
        } else if (Py < LAYOUT_P - 1 and Py % 2 == 1) {
          @set_color_config(Px, Py, ns_color_b, .{ .routes = RX_SOUTH_TX_RAMP });
        }
      }
    }
  }

  // ---------------------------------------------------------------------------
  // HOST-VISIBLE EXPORTS
  // ---------------------------------------------------------------------------
  @export_name("D_shard",     [*]f32, true);
  @export_name("q",           [*]f32, true);
  @export_name("row_norms",   [*]f32, true);
  @export_name("final_dists", [*]f32, false);
  @export_name("final_idxs",  [*]u32, false);
  @export_name("main",        fn()void);
}
